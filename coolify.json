{
  "version": "1.0",
  "name": "holo",
  "description": "Self-hosted AI context layer + skill execution",
  "services": [
    {
      "name": "holo-web",
      "type": "dockerfile",
      "dockerfilePath": "apps/web/Dockerfile",
      "port": 3000,
      "healthcheck": "/api/health",
      "env": ["DATABASE_URL", "REDIS_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "WEB_PUBLIC_URL", "MCP_PUBLIC_URL", "ANTHROPIC_API_KEY", "GITHUB_LOGIN_CLIENT_ID", "GITHUB_LOGIN_CLIENT_SECRET", "HOLO_TOKEN_ENCRYPTION_KEY"]
    },
    {
      "name": "holo-gateway",
      "type": "dockerfile",
      "dockerfilePath": "apps/gateway/Dockerfile",
      "port": 8080,
      "healthcheck": "/health",
      "env": ["DATABASE_URL", "REDIS_URL", "MCP_PUBLIC_URL", "WEB_PUBLIC_URL", "BETTER_AUTH_SECRET", "HOLO_TOKEN_ENCRYPTION_KEY"]
    },
    {
      "name": "holo-worker",
      "type": "dockerfile",
      "dockerfilePath": "apps/worker/Dockerfile",
      "env": ["DATABASE_URL", "REDIS_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "HOLO_TOKEN_ENCRYPTION_KEY", "ANTHROPIC_API_KEY", "OPENAI_API_KEY", "VOYAGE_API_KEY"]
    },
    {
      "name": "postgres",
      "type": "image",
      "image": "pgvector/pgvector:pg16",
      "env": ["POSTGRES_USER", "POSTGRES_PASSWORD", "POSTGRES_DB"],
      "volumes": ["holo_pg_data:/var/lib/postgresql/data"]
    },
    {
      "name": "redis",
      "type": "image",
      "image": "redis:7-alpine",
      "volumes": ["holo_redis_data:/data"]
    }
  ]
}
