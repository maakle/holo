{
  "name": "@holo/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --include '../../packages/**/src/**/*.ts' --env-file=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@holo/agent-tools": "workspace:*",
    "@holo/audit": "workspace:*",
    "@holo/auth": "workspace:*",
    "@holo/connectors": "workspace:*",
    "@holo/crypto": "workspace:*",
    "@holo/custom-tools": "workspace:*",
    "@holo/db": "workspace:*",
    "@holo/env": "workspace:*",
    "@holo/errors": "workspace:*",
    "@holo/oauth-provider": "workspace:*",
    "@holo/retrieval-core": "workspace:*",
    "@holo/skills": "workspace:^",
    "@holo/user-subjects": "workspace:*",
    "bullmq": "5.20.1",
    "@hono/node-server": "1.13.2",
    "@hono/zod-openapi": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@scalar/hono-api-reference": "^0.10.13",
    "drizzle-orm": "0.45.2",
    "hono": "4.6.7",
    "pino": "9.5.0",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "drizzle-orm": "0.45.2",
    "pino-pretty": "^13.1.3",
    "postgres": "3.4.9",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
