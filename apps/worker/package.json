    "@holo/env": "workspace:*",
    "@holo/errors": "workspace:*",
    "@nestjs/bullmq": "10.2.3",
    "drizzle-orm": "0.36.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "bullmq": "5.20.1",
    "ioredis": "5.4.1",
    "postgres": "3.4.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "pino": "9.5.0",
    "nestjs-pino": "4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
