{
  "name": "@holo/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --include '../../packages/**/src/**/*.ts' --env-file=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@holo/agent-tools": "workspace:*",
    "@holo/audit": "workspace:*",
    "@holo/billing": "workspace:*",
    "@holo/chunker": "workspace:*",
    "@holo/connector-framework": "workspace:*",
    "@holo/connectors": "workspace:*",
    "@holo/crypto": "workspace:*",
    "@holo/db": "workspace:*",
    "@holo/embedder": "workspace:*",
    "@holo/env": "workspace:*",
    "@holo/errors": "workspace:*",
    "@holo/llm": "workspace:*",
    "@holo/retrieval-core": "workspace:*",
    "@holo/skills": "workspace:*",
    "@holo/stripe": "workspace:*",
    "@holo/sync-providers": "workspace:*",
    "@holo/user-subjects": "workspace:*",
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "bullmq": "5.20.1",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.4.1",
    "nestjs-pino": "4.1.0",
    "pino": "9.5.0",
    "posthog-node": "^5.34.6",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "pino-pretty": "^13.1.3",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
