    "@holo/errors": "workspace:*",
    "@holo/retrieval-core": "workspace:*",
    "hono": "4.6.7",
    "@hono/node-server": "1.13.2",
    "pino": "9.5.0"
  },
  "devDependencies": {
    "drizzle-orm": "0.36.0",
    "postgres": "3.4.4",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
