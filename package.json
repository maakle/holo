{
  "name": "memex",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm -F @memex/db migrate",
    "db:generate": "pnpm -F @memex/db generate"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.6.3"
  }
}
