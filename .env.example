# Postgres (host port 5436 -> container 5432; non-default to avoid conflicts with other dev DBs).
POSTGRES_USER=holo
POSTGRES_PASSWORD=
POSTGRES_DB=holo
DATABASE_URL=postgresql://holo:CHANGE_ME@localhost:5436/holo
REDIS_URL=redis://localhost:6382
HOLO_TOKEN_ENCRYPTION_KEY= # Generate both with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_PUBLIC_URL= # Publicly reachable URL for OAuth redirect_uri callbacks (Slack, Linear).

# Optional: extra origins Better Auth should trust in addition to BETTER_AUTH_URL.
# Useful in dev when accessing Holo over both localhost and an ngrok / preview
# tunnel. Comma-separated, no trailing slash.
# Example:
# AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://abc-123.ngrok-free.dev
# AUTH_TRUSTED_ORIGINS=

# Public URL of the gateway (apps/gateway — MCP + REST). Shown to users on /connect-agent.
MCP_PUBLIC_URL=http://localhost:8080

# Better Auth — sign in to holo with GitHub
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=

# GitHub App for the connector (see ADR 0005).
# Generate the private key as a base64 single-line string:
#   base64 -i path/to/holo-dev.private-key.pem | tr -d '\n'
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_WEBHOOK_SECRET=

GITLAB_CONNECTOR_CLIENT_ID=
GITLAB_CONNECTOR_CLIENT_SECRET=

SLACK_CONNECTOR_CLIENT_ID=
SLACK_CONNECTOR_CLIENT_SECRET=
SLACK_CONNECTOR_SIGNING_SECRET=

# Linear: no global env vars. Personal API keys (Settings → API) are
# collected through the wizard and stored per-org in connector_credentials.

# GitLab OAuth Application (gitlab.com).
# Register at https://gitlab.com/-/profile/applications:
#   Redirect URI: ${WEB_PUBLIC_URL}/api/connectors/gitlab/callback
#   Scopes:       read_api, read_repository, read_user
#   Confidential: yes
GITLAB_CONNECTOR_CLIENT_ID=
GITLAB_CONNECTOR_CLIENT_SECRET=

# Email delivery (invitations + future OTP):
#   EMAIL_PROVIDER=console — log to stdout (default; use in dev)
#   EMAIL_PROVIDER=resend  — send via Resend; requires RESEND_API_KEY and EMAIL_FROM
# EMAIL_FROM must use a domain verified in Resend (e.g. "Holo <noreply@holo.com>").
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# Optional
NODE_ENV=development
LOG_LEVEL=info

# Anthropic key — REQUIRED for the worker (Slack bot agent). Worker will fail
# fast at boot if this is unset. Other services (gateway) do not need it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Optional: pick which Anthropic models Holo uses. Defaults pick the latest
# Sonnet for user-facing agents (web chat + Slack bot) and the latest Haiku
# for background pipeline work (skill auto-extract, discovery proposals,
# redaction, label synthesis). Override per deploy if you want to A/B a
# different tier or swap to a newly-released model. Strings pass through to
# the Anthropic SDK as-is — a typo surfaces as `model_not_found` on the
# first call, not silent miswiring.
ANTHROPIC_AGENT_MODEL=claude-sonnet-4-6
ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5-20251001

# Optional: pick which OpenAI embedding model Holo uses for prose chunks.
# Defaults to text-embedding-3-small (1024 dims, ~6.5x cheaper than
# -large with a small recall delta in practice for hybrid retrieval).
# Switching requires re-running the embed-backfill job to migrate existing
# chunks (HOLO_EMBED_BACKFILL_ENABLED=1 on the worker). Allowed values:
# text-embedding-3-small, text-embedding-3-large.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
