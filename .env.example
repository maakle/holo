# Postgres (host port 5436 -> container 5432; non-default to avoid conflicts with other dev DBs).
# Generate POSTGRES_PASSWORD with: openssl rand -base64 24
# Use the SAME password value in DATABASE_URL below (Node's dotenv doesn't expand vars).
POSTGRES_USER=holo
POSTGRES_PASSWORD=
POSTGRES_DB=holo
DATABASE_URL=postgresql://holo:CHANGE_ME@localhost:5436/holo

# Redis (host port 6382 -> container 6379)
REDIS_URL=redis://localhost:6382

# Generate both with: openssl rand -base64 32
HOLO_TOKEN_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

# Set to your dashboard URL (used as the OAuth redirect host)
BETTER_AUTH_URL=http://localhost:3000

# Public URL of the gateway (apps/gateway — MCP + REST). Shown to users on /connect-agent.
MCP_PUBLIC_URL=http://localhost:8080

# Connectors or Oauth
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
GITHUB_CONNECTOR_CLIENT_ID=
GITHUB_CONNECTOR_CLIENT_SECRET=

# GitHub App for the connector (target auth model — see ADR 0005).
# Generate the private key as a base64 single-line string:
#   base64 -i path/to/holo-dev.private-key.pem | tr -d '\n'
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_WEBHOOK_SECRET=

SLACK_CONNECTOR_CLIENT_ID=
SLACK_CONNECTOR_CLIENT_SECRET=

HUBSPOT_CONNECTOR_CLIENT_ID=
HUBSPOT_CONNECTOR_CLIENT_SECRET=

# Email OTP delivery: 'console' logs codes to stdout; 'resend' uses RESEND_API_KEY
# (Email OTP login deferred from v0.0 — GitHub-only for now; this var reserved for v0.1.)
EMAIL_PROVIDER=console
RESEND_API_KEY=

# Optional
NODE_ENV=development
LOG_LEVEL=info

# Anthropic key — placeholder for spec #2 (embedding/synthesis); not used in Foundation
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
