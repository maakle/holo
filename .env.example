# Postgres (host port 5436 -> container 5432; non-default to avoid conflicts with other dev DBs).
POSTGRES_USER=holo
POSTGRES_PASSWORD=
POSTGRES_DB=holo
DATABASE_URL=postgresql://holo:CHANGE_ME@localhost:5436/holo
REDIS_URL=redis://localhost:6382
HOLO_TOKEN_ENCRYPTION_KEY= # Generate both with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_PUBLIC_URL= # Publicly reachable URL for OAuth redirect_uri callbacks (Slack, Grain, HubSpot).

# Optional: extra origins Better Auth should trust in addition to BETTER_AUTH_URL.
# Useful in dev when accessing Holo over both localhost and an ngrok / preview
# tunnel. Comma-separated, no trailing slash.
# Example:
# AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://abc-123.ngrok-free.dev
# AUTH_TRUSTED_ORIGINS=

# Public URL of the gateway (apps/gateway — MCP + REST). Shown to users on /connect-agent.
MCP_PUBLIC_URL=http://localhost:8080

# Better Auth — sign in to holo with GitHub
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=

# GitHub App for the connector (see ADR 0005).
# Generate the private key as a base64 single-line string:
#   base64 -i path/to/holo-dev.private-key.pem | tr -d '\n'
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_WEBHOOK_SECRET=

SLACK_CONNECTOR_CLIENT_ID=
SLACK_CONNECTOR_CLIENT_SECRET=
SLACK_CONNECTOR_SIGNING_SECRET=

# Email OTP delivery: 'console' logs codes to stdout; 'resend' uses RESEND_API_KEY
# (Email OTP login deferred from v0.0 — GitHub-only for now; this var reserved for v0.1.)
EMAIL_PROVIDER=console
RESEND_API_KEY=

# Optional
NODE_ENV=development
LOG_LEVEL=info

# Anthropic key — placeholder for spec #2 (embedding/synthesis); not used in Foundation
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
